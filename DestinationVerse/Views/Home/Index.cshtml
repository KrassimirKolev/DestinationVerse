@{
    ViewData["Title"] = "Добре дошли";
}

<!-- 🗺️ Светла и приветствена секция -->
<div class="py-5 text-center bg-light rounded shadow-sm border mb-5">
    <div class="container py-3">
        <h1 class="display-4 fw-bold text-primary">Добре дошли в DestinationVerse</h1>
        <p class="lead text-muted mx-auto" style="max-width: 750px;">
            Вашето лично софтуерно пространство за споделяне, планиране и откриване на най-вълнуващите туристически маршрути и забележителности в България.
        </p>
        <div class="text-secondary small mt-3">
            🔒 <em>За достъп до пълния каталог и Вашия личен пътеводител, моля използвайте бутоните <strong>Login</strong> или <strong>Register</strong> горе вдясно.</em>
        </div>
    </div>
</div>

<!-- 🛠️ Информационни карти представящи системата -->
<div class="container">
    <div class="row g-4 justify-content-center">
        <!-- Карта 1 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-3 bg-white">
                <div class="card-body">
                    <div class="fs-1 mb-2 text-primary">🗺️</div>
                    <h5 class="card-title fw-bold">Споделяне на дестинации</h5>
                    <p class="card-text text-muted small">Въвеждайте нови интересни географски обекти, забележителности, детайлни описания и линкове към снимки от природата.</p>
                </div>
            </div>
        </div>

        <!-- Карта 2 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-3 bg-white">
                <div class="card-body">
                    <div class="fs-1 mb-2 text-success">⭐</div>
                    <h5 class="card-title fw-bold">Личен Пътеводител</h5>
                    <p class="card-text text-muted small">Създавайте своя собствена потребителска колекция от любими маршрути, които искате да посетите или следите динамично.</p>
                </div>
            </div>
        </div>

        <!-- Карта 3 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-3 bg-white">
                <div class="card-body">
                    <div class="fs-1 mb-2 text-warning">📍</div>
                    <h5 class="card-title fw-bold">Регионално управление</h5>
                    <p class="card-text text-muted small">Гъвкаво филтриране и CRUD управление на географските райони по софтуерно чист трислоен архитектурен модел.</p>
                </div>
            </div>
        </div>
    </div>
</div>

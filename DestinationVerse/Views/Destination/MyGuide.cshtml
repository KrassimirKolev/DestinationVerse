@using DestinationVerse.Data.Entities
@model IEnumerable<Destination>

@{
    ViewData["Title"] = "Моят Пътеводител";
}

<h2 class="mb-4 text-success border-bottom pb-2">⭐ @ViewData["Title"]</h2>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center my-5">
            <p class="text-muted fs-4">Вашият пътеводител все още е празен. Добавете дестинации от началната страница!</p>
            <a asp-controller="Destination" asp-action="Index" class="btn btn-primary mt-2">Разгледай дестинации</a>
        </div>
    }
    else
    {
        @foreach (var destination in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrEmpty(destination.CoverImageUrl))
                    {
                        <img src="@destination.CoverImageUrl" class="card-img-top" alt="@destination.Title" style="height: 220px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light text-center py-5 border-bottom" style="height: 220px;">
                            <span class="text-muted fs-1">🗺️</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title text-success fw-bold">@destination.Title</h5>
                        <p class="card-text text-muted text-truncate">@destination.Description</p>
                        <span class="badge bg-secondary mb-2">📍 @destination.Region.Name</span>
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex gap-2 pb-3">
                        <a asp-controller="Destination" asp-action="Details" asp-route-id="@destination.Id" class="btn btn-outline-info btn-sm w-100">Детайли</a>
                        <form asp-controller="Destination" asp-action="RemoveFromGuide" asp-route-id="@destination.Id" method="post" class="w-100">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Премахни</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

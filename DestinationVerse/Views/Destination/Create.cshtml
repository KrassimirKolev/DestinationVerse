@using DestinationVerse.ViewModels.Destination
@model DestinationFormModel

@{
    ViewData["Title"] = "Добави нова дестинация";
}

<div class="row justify-content-center">
    <div class="col-md-8 shadow-sm p-4 bg-white rounded border">
        <h3 class="text-primary border-bottom pb-2 mb-4">@ViewData["Title"]</h3>

        <form asp-controller="Destination" asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Заглавие</label>
                <input asp-for="Title" class="form-control" placeholder="Въведете заглавие на дестинацията..." />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Опишете забележителностите и интересните места..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CoverImageUrl" class="form-label fw-bold">Линк към снимка (Изображение)</label>
                <input asp-for="CoverImageUrl" class="form-control" placeholder="https://example.com" />
                <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="RegionId" class="form-label fw-bold mb-0">Изберете регион</label>
                    <a asp-controller="Destination" asp-action="CreateRegion" class="text-decoration-none small text-success">➕ Нов регион</a>
                </div>

                <select asp-for="RegionId" class="form-select" asp-items="@(new SelectList(Model.Regions, "Id", "Name"))">
                    <option value="" selected disabled>-- Изберете регион от списъка --</option>
                </select>
                <span asp-validation-for="RegionId" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 justify-content-end border-top pt-3">
                <a asp-controller="Destination" asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                <button type="submit" class="btn btn-primary px-4">Запиши дестинацията</button>
            </div>
        </form>
        <div class="row justify-content-center mt-4">
            <div class="col-md-8 p-3 bg-light rounded border shadow-sm">
                <h5 class="text-secondary fw-bold mb-3">🗺️ Налични географски региони в системата</h5>
                <table class="table table-sm table-hover align-middle bg-white rounded">
                    <thead>
                        <tr>
                            <th>Име на регион</th>
                            <!-- Линковете за управление се виждат в заглавието само от Администратор -->
                            @if (User.IsInRole("Administrator"))
                            {
                                <th class="text-end" style="width: 170px;">Администриране</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var region in Model.Regions)
                        {
                            <tr>
                                <td class="fw-bold text-dark">📍 @region.Name</td>

                                <!-- 🔐 РОЛЕВА ИНТЕГРАЦИЯ: Обикновеният потребител вижда само списъка, без бутони! -->
                                @if (User.IsInRole("Administrator"))
                                {
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <a asp-controller="Destination" asp-action="EditRegion" asp-route-id="@region.Id" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size: 0.8rem;">Промени</a>
                                            <form asp-controller="Destination" asp-action="DeleteRegion" asp-route-id="@region.Id" method="post" onsubmit="return confirm('Сигурни ли сте, че искате да премахнете този регион?');" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.8rem;">Изтрий</button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

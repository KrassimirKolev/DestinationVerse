@{
    ViewData["Title"] = "Добави нов географски регион";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 shadow-sm p-4 bg-white rounded border">
        <h4 class="text-primary border-bottom pb-2 mb-3">📍 @ViewData["Title"]</h4>

        <form asp-controller="Destination" asp-action="CreateRegion" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Име на региона</label>
                <input type="text" name="name" class="form-control" placeholder="Напр. Сакар, Родопи, Пирин..." required />
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Name"]?.Errors.Count > 0)
                {
                    <span class="text-danger small">@ViewData.ModelState["Name"]?.Errors[0].ErrorMessage</span>
                }
            </div>

            <div class="d-flex gap-2 justify-content-end border-top pt-3">
                <a asp-controller="Destination" asp-action="Create" class="btn btn-outline-secondary">Назад</a>
                <button type="submit" class="btn btn-success px-4">Добави Регион</button>
            </div>
        </form>
    </div>
</div>

@model string
@{
    ViewData["Title"] = "Редактирай име на регион";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 shadow-sm p-4 bg-white rounded border">
        <h4 class="text-warning border-bottom pb-2 mb-3">⚙️ @ViewData["Title"]</h4>

        <form asp-controller="Destination" asp-action="EditRegion" asp-route-id="@ViewBag.RegionId" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Име на региона</label>
                <input type="text" name="name" class="form-control" value="@Model" required />
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState["Name"]?.Errors.Count > 0)
                {
                    <span class="text-danger small">@ViewData.ModelState["Name"]?.Errors[0].ErrorMessage</span>
                }
            </div>

            <div class="d-flex gap-2 justify-content-end border-top pt-3">
                <a asp-controller="Destination" asp-action="Create" class="btn btn-outline-secondary">Отказ</a>
                <button type="submit" class="btn btn-warning px-4 fw-bold">Обнови Регион</button>
            </div>
        </form>
    </div>
</div>
